# ==========================================
# Environment Variables Example Template
# Copy this file to .env and fill in real values
# ==========================================

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/procurement_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password

# Server Port
SERVER_PORT=8083

# JWT Configuration (minimum 32 characters for HS256)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION_MS=3600000

# Demo User Seeding (set to true only for local demo/testing; default is false)
SEED_DEMO_USERS=false
DEMO_ADMIN_PASSWORD=your_secure_admin_password
DEMO_MANAGER_PASSWORD=your_secure_manager_password
DEMO_EMPLOYEE_PASSWORD=your_secure_employee_password
